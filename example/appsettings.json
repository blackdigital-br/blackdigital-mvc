{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    // Never commit a real secret. Provide it in production through the
    // environment variable Jwt__SecretKey (at least 32 bytes) — the app fails
    // fast at startup when SecretKey, Issuer or Audience are missing.
    "SecretKey": "",
    "Issuer": "BlackDigital.Example",
    "Audience": "BlackDigital.Example",
    "ExpirationMinutes": 60
  }
}
