<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>Logo128.png</PackageIcon>
		<Version>26.10.11.19</Version>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>BlackDigital.AspNet</Title>
		<Description>BlackDigital ASP.NET Core Extensions</Description>
		<Authors>BlackDigital</Authors>
		<Company>BlackDigital</Company>
		<RepositoryUrl>https://github.com/blackdigital-br/blackdigital-mvc</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>https://github.com/blackdigital-br/blackdigital-mvc</PackageProjectUrl>
		<PackageTags>BlackDigital;AspNet;AspNetCore;Extensions;Helpers;Utilities</PackageTags>	
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\doc\images\Logo128.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\LICENSE">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BlackDigital" Version="26.10.10.21" />
		<PackageReference Include="BlackDigital.Domain" Version="26.10.11.1" />
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="Microsoft.OpenApi" Version="3.10.2" />
		<PackageReference Include="Scalar.AspNetCore" Version="2.17.14" />
	</ItemGroup>

</Project>
